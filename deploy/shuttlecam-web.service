[Unit]
Description=shuttlecam phone web app (Smash Speed box, docs/pi-hotspot.md)
After=network-online.target NetworkManager.service
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@REPO@
# Uses @DATA@/drag.toml (a tuned shuttle drag) when it exists.
ExecStart=/bin/bash -c 'cfg=""; [ -f "@DATA@/drag.toml" ] && cfg="-c @DATA@/drag.toml"; exec @REPO@/.venv/bin/shuttlecam $cfg serve --host 0.0.0.0 --port 80 --data "@DATA@"'
# Port 80 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
